VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon key only. Never put the service_role key (or any secret) in a
# VITE_* variable: everything prefixed VITE_ is compiled into the browser bundle.
VITE_SUPABASE_ANON_KEY=
# Browser map keys: restrict each one to your domains in its provider console.
VITE_MAPBOX_TOKEN=
VITE_CARTO_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_ORS_API_KEY=
VITE_MAP_STYLE_URL=
